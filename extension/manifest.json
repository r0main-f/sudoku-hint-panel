{
  "manifest_version": 3,
  "name": "Sudoku Hint Panel",
  "short_name": "Sudoku Hints",
  "version": "4.3.0",
  "description": "Learn sudoku on sudoku.com, NYT, Web Sudoku and more: from notes to one hint at a time with its reasoning, at your level.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sudoku Hint Panel — help on any grid (4×4 to 16×16)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sudoku.com/*",
        "https://www.sudoku.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://sudoku.com/*",
        "https://www.sudoku.com/*"
      ],
      "js": [
        "engine.js",
        "explain.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.nytimes.com/puzzles/sudoku*",
        "https://websudoku.com/*",
        "https://*.websudoku.com/*",
        "https://sudoku-online.org/*",
        "https://www.sudoku-online.org/*",
        "https://www.livesudoku.com/*",
        "https://livesudoku.com/*",
        "https://sudokuonline.io/*",
        "https://www.sudokuonline.io/*"
      ],
      "js": [
        "engine.js",
        "explain.js",
        "deco.js",
        "sites.js",
        "site-panel.js"
      ],
      "css": [
        "site-panel.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
