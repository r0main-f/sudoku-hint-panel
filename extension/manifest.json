{
  "manifest_version": 3,
  "name": "Sudoku Hint Panel",
  "short_name": "Sudoku Hints",
  "version": "3.2.0",
  "description": "A light hint panel for sudoku.com: candidates, single options, pairs, triples and pointing, shown step by step.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://sudoku.com/*", "https://www.sudoku.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://sudoku.com/*", "https://www.sudoku.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
